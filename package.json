{
  "name": "zhandao",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "test": "npm --workspace server run test",
    "search": "npm --workspace server run search --",
    "note": "npm --workspace server run note --",
    "eval": "npm --workspace server run eval",
    "keywords": "npm --workspace server run keywords --",
    "expand": "npm --workspace server run expand --"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
